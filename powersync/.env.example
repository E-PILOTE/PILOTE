# ─── E-PILOTE CONGO — Variables PowerSync ────────────────────────────────────
# COPIER ce fichier en .env et remplir les vraies valeurs
# ⚠️  Ne JAMAIS committer .env dans git

# Mot de passe du rôle powersync_role (défini dans supabase-setup.sql)
SUPABASE_DB_PASSWORD=MOT_DE_PASSE_ICI

# JWT Secret — Supabase Dashboard → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=VOTRE_JWT_SECRET_ICI

# Mot de passe de la base PostgreSQL locale (stockage PowerSync)
STORAGE_DB_PASSWORD=epilote_storage_2026
